# Postgres connection. The docker-compose.yml database uses this value.
DATABASE_URL=postgresql://porch:porch@localhost:5432/porch

# Public URL of the app, used for PayPal return links and the map lookup user agent.
APP_URL=http://localhost:3000

# Any long random string. Signs login cookies.
SESSION_SECRET=

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Filled in after the webhook is registered (npm run paypal:webhook). Optional.
PAYPAL_WEBHOOK_ID=

# OpenRouter key for the photo-to-listing model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-4-scout

# Channel3 product search key (trychannel3.com/developers).
CHANNEL3_API_KEY=

# eBay production keyset (developer.ebay.com). Optional; pricing works without it.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Shared secret for the cron endpoint.
CRON_SECRET=

# true adds the seeded demo town and the switch user menu.
DEMO_MODE=true

# Demo mode only: sandbox seller accounts that receive demo payouts (comma separated), and the demo login password.
DEMO_PAYOUT_EMAILS=
DEMO_PASSWORD=
